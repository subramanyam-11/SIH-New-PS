# Environment variables for AICTE Approval Workflow System (SIH26262)

# ==============================================================================
# 1. Application & Environment Mode
# ==============================================================================
ENVIRONMENT=development
# DEMO_MODE: Set to true for hackathon jury evaluation with fast-login personas.
# In production, must be false to disable demo login routes and demo chips.
DEMO_MODE=true

# ==============================================================================
# 2. Database (PostgreSQL 15+)
# ==============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aicte_workflow
# Cloud alternatives (e.g. Supabase, Neon) can be swapped in without code change:
# DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ==============================================================================
# 3. Authentication & Access Security
# ==============================================================================
# JWT_SECRET: Cryptographically secure secret key for signing access tokens.
# Change in production! Minimum 256 bits recommended.
JWT_SECRET=super-secret-key-change-in-production-aicte-2026-sih
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Login Rate Limiting & Account Lockout
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ==============================================================================
# 4. CORS Origins (Comma-separated)
# ==============================================================================
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# ==============================================================================
# 5. File Encryption & Anti-Malware Storage Security
# ==============================================================================
# Symmetrically encrypts all uploaded documents at rest using AES-256-GCM.
# Format: 'b64:<base64-encoded-32-byte-key>' or raw 32 characters.
FILE_ENCRYPTION_KEY=b64:k8V9H9eY6j2Rz+1wT8g4P0L6n+M4q1A3u5Y7c9e0w2I=
FILE_ENCRYPTION_KEY_ID=key_v1
MAX_FILE_SIZE_BYTES=10485760

# Anti-Virus Scanner: ClamAV Daemon Host and Port (Leave empty to use DemoScanner)
CLAMAV_HOST=
CLAMAV_PORT=3310

# ==============================================================================
# 6. Mock AICTE National Portal Integration
# ==============================================================================
# Secrets for external webhook authentication via X-API-Key and HMAC-SHA256 signature
INTEGRATION_API_KEY=aicte-sandbox-api-key-2026-secret
INTEGRATION_HMAC_SECRET=aicte-hmac-sha256-signing-secret-2026

# ==============================================================================
# 7. LLM Provider Configuration (Optional)
# ==============================================================================
# Default is 'none' (deterministic offline template summary)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_TIMEOUT_SECONDS=10

# ==============================================================================
# 8. SMTP Outbox & Email Notifications
# ==============================================================================
# In development, emails are drafted into the 'email_outbox' database table.
# Set EMAIL_SEND_ENABLED=true to dispatch over live SMTP server.
EMAIL_SEND_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@aicte-india.org
SMTP_TLS=false

# ==============================================================================
# 9. Background Scheduler
# ==============================================================================
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=5
