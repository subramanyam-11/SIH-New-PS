# Environment variables for AICTE Approval Workflow System

# Application Mode
ENVIRONMENT=development
DEMO_MODE=true

# Database (PostgreSQL 15)
# Local Docker or Native Postgres:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aicte_workflow
# Cloud alternatives (e.g. Supabase, Neon) can be swapped in without code change:
# DATABASE_URL=postgresql://user:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Authentication & Security
JWT_SECRET=super-secret-key-change-in-production-aicte-2026-sih
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM Configuration (Phase 2 uses deterministic fallback; plug API key when ready)
LLM_PROVIDER=template_fallback
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# SMTP / Email Notification Settings (mocked to console in development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@aicte-india.org
SMTP_TLS=false
